pipeline {
    agent any

    environment {
        REPO_URL = "https://github.com/sudarshanbarure/Jenkins1911.git"
        ZIP_FILE = "node-app.zip"
        APP_DIR = "node-app"
        IMAGE_NAME = "nodejs-app"
        CONTAINER_NAME = "nodejs-container"
        PORT = "3000"
    }

    stages {

        stage('Clone Repository') {
            steps {
                git url: "${REPO_URL}", branch: "main"
            }
        }

        stage('Extract Node App') {
            steps {
                sh """
                rm -rf ${APP_DIR}
                unzip ${ZIP_FILE} -d ${APP_DIR}
                """
            }
        }

    stage('Build Docker Image') {
        steps {
         sh """
         cd node-app/node-app
            docker build -t nodejs-app:latest .
         """
                 }
        }

        stage('Stop Old Container') {
            steps {
                sh """
                if [ \$(docker ps -q -f name=${CONTAINER_NAME}) ]; then
                    docker stop ${CONTAINER_NAME}
                fi
                if [ \$(docker ps -aq -f name=${CONTAINER_NAME}) ]; then
                    docker rm ${CONTAINER_NAME}
                fi
                """
            }
        }

        stage('Run New Container') {
            steps {
                sh """
                docker run -d --name ${CONTAINER_NAME} -p ${PORT}:${PORT} ${IMAGE_NAME}:latest
                """
            }
        }
    }
}
